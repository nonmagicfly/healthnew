{
  "name": "health-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-local-samples.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-local-samples.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "node scripts/ensure-local-samples.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node scripts/ensure-local-samples.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "postinstall": "node scripts/ensure-local-samples.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "next": "16.4.2",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
